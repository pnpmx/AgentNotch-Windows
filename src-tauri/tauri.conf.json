{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentNotch",
  "version": "0.1.0",
  "identifier": "dev.agentnotch.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentNotch",
        "url": "index.html",
        "width": 50,
        "height": 176,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Codex and Claude usage at the edge of your screen, with local dictation",
    "longDescription": "Edge-docked widget showing Codex and Claude Code usage limits, with on-device push-to-talk dictation powered by whisper.cpp.",
    "copyright": "Copyright (c) 2026 AgentNotch contributors. MIT License.",
    "license": "MIT",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
